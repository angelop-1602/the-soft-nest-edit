{
  "name": "the-soft-nest-edit-staging",
  "main": "src/index.js",
  "compatibility_date": "2026-11-18",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "staging.thesoftnestedit.online", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin/products", "/admin/products/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "softnest-orders-staging",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],
  "observability": { "logs": { "enabled": false } },
  "vars": {
    "PAYPAL_MODE": "sandbox",
    "PAYPAL_SANDBOX_CHECKOUT_ENABLED": "false",
    "PRODUCT_SANDBOX_CHECKOUT_ENABLED": "false"
  }
}
