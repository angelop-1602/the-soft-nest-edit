
{
  "name": "the-soft-nest-edit",
  "main": "src/index.js",
  "compatibility_date": "2026-11-18",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "softnest-orders-sandbox",
      "database_id": "REPLACE_WITH_YOUR_DATABASE_ID"
    }
  ]
}
